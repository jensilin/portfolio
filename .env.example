# EmailJS credentials for the contact form (src/components/Contact.jsx).
# Copy this file to .env.local and fill in the values from the EmailJS dashboard.
#
# Vite inlines VITE_* variables at BUILD time, so hosted deployments need these
# set as build-time environment variables and then rebuilt — saving them without
# a fresh deploy leaves the old bundle unconfigured.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
